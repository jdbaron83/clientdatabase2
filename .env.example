# Copy to .env and fill in. Never commit .env.

# The web address staff will use, without https://
DOMAIN=records.example.org

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=records.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://records.example.org
POSTGRES_PASSWORD=change-me

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up somewhere safe: without it, stored SSNs can't be read.
FIELD_ENCRYPTION_KEY=
